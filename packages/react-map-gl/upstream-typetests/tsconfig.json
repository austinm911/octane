{
  "compilerOptions": {
    "module": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "target": "esnext",
    "noEmit": true,
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "types": ["react", "node"],
    "skipLibCheck": false
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
